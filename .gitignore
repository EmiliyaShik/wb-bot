# Секреты - НИКОГДА не коммитим (кроме шаблона .env.example)
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Архивы
wb-bot.zip

# Autopilot: служебные файлы сборки. Секретов там нет, но это внутренняя
# кухня, а репозиторий публичный. Файлы остаются на машине владельца.
.autopilot/

# Данные, база, счета и выгрузки - никогда не коммитим
data/
*.db
*.sqlite3
invoices/
exports/
*.xlsx
!**/templates/*.xlsx

# Документы Word рядом с кодом. Владелец держит в них рабочие записи, и один
# такой файл уже лежал в папке проекта с токеном бота внутри: репозиторий
# публичный, и случайный `git add .` отправил бы его всему свету.
*.docx
*.doc
*.rtf

# Скриншоты, которые роняют в папку проекта перетаскиванием
image-*.png
screenshot*.png
Снимок экрана*.png

# Служебные файлы Word и Excel
~$*
