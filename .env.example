# Шаблон переменных окружения. Скопируйте в .env и заполните.
# Реальных значений здесь нет и быть не должно: репозиторий публичный.

# --- Обязательное ---

# Токен бота, полученный у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Ключ шифрования токенов клиентов (Fernet).
# Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Без него бот работает, но принимать токены кабинетов не может.
ENCRYPTION_KEY=

# --- Владелец и данные ---

# Telegram ID владельца, через запятую. Пусто - админ-команд нет ни у кого.
ADMIN_TELEGRAM_IDS=

# Папка данных. Локально ./data, на Bothost /app/data (всё вне неё стирается при деплое).
DATA_DIR=

# --- Реквизиты ИП для счёта ---
# Пока пусты, счёт не выставляется, и бот объясняет владельцу, чего не хватает.

SELLER_NAME=
SELLER_INN=
SELLER_OGRNIP=
SELLER_ADDRESS=
SELLER_ACCOUNT=
SELLER_BANK=
SELLER_BIK=
SELLER_CORR_ACCOUNT=

# --- Оферта и связь ---

# Ссылка на оферту. Пока пуста, клиенту говорится, что оферта готовится.
OFFER_URL=

# Контакт владельца для /paysupport и оплаты картой
OWNER_CONTACT=

# --- Внешние сервисы ---

# Ключ DaData для проверки ИНН. Без него реквизиты вводятся руками.
DADATA_API_KEY=

# Прокси ТОЛЬКО для запросов к Wildberries (обход гео-блокировки).
# Запросы к Telegram идут напрямую, без прокси.
# По умолчанию прокси выключен. Чтобы включить, задайте обе переменные:
#   WB_PROXY_ENABLED=1
#   WB_PROXY=http://user:pass@host:port   (или socks5://host:port)
# Для socks-прокси нужна доп. зависимость: pip install "httpx[socks]"
WB_PROXY_ENABLED=
WB_PROXY=
