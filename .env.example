# Токен бота, полученный у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your-token-here

# (необязательно) Прокси ТОЛЬКО для запросов к Wildberries.
# Помогает обойти гео-блокировку с не-российского IP.
# Запросы к Telegram идут напрямую, без прокси.
#
# По умолчанию прокси ВЫКЛЮЧЕН — запросы идут напрямую. Чтобы включить,
# задайте обе переменные:
#   WB_PROXY_ENABLED=1
#   WB_PROXY=http://user:pass@host:port   (или socks5://host:port)
# Для socks-прокси нужна доп. зависимость: pip install "httpx[socks]"
# WB_PROXY_ENABLED=0
# WB_PROXY=http://user:pass@host:port
